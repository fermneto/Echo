{
  "name": "echo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d --wait db",
    "triage:up": "docker compose up -d --build triage",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @echo/db migrate",
    "db:generate": "pnpm --filter @echo/db generate",
    "db:seed": "pnpm --filter @echo/seed seed",
    "evals": "pnpm --filter @echo/evals evals",
    "e2e": "echo \"e2e: etapa 16 (frente Avaliador)\" && exit 1",
    "integracoes:ligar": "pnpm --filter @echo/connectors integracoes:ligar",
    "acao:testar": "pnpm --filter @echo/actions acao:testar",
    "integracoes:conferir": "pnpm --filter @echo/connectors slack:check; pnpm --filter @echo/connectors github:check; pnpm --filter @echo/connectors linear:check",
    "integracoes:reconciliar": "pnpm --filter @echo/worker reconciliar",
    "nota:agora": "pnpm --filter @echo/worker nota:agora",
    "noite:agora": "pnpm --filter @echo/worker noite:agora",
    "integracoes:rh": "pnpm --filter @echo/connectors integracoes:rh",
    "integracoes:agenda": "pnpm --filter @echo/connectors agenda:check",
    "integracoes:diagnostico": "pnpm --filter @echo/connectors integracoes:diagnostico",
    "integracoes:simular": "pnpm --filter @echo/connectors integracoes:simular",
    "integracoes:atividade": "pnpm --filter @echo/connectors integracoes:atividade"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
