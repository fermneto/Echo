{
  "name": "echo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @echo/db migrate",
    "db:generate": "pnpm --filter @echo/db generate",
    "db:seed": "pnpm --filter @echo/seed seed",
    "evals": "pnpm --filter @echo/evals evals",
    "e2e": "echo \"e2e: etapa 16 (frente Avaliador)\" && exit 1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
