# Triagem da revisão noturna: Ollama com um modelo aberto pequeno já embutido na imagem (sem baixar ao subir).
# Qwen3 4B Instruct (Apache 2.0, ~2,5 GB, sem bloco de raciocínio) roda em CPU; precisa de ~3,5 GB de RAM.
# Alternativa menor, para 2 GB: --build-arg SLM_MODEL=qwen2.5-coder:1.5b (erra mais; ver docs/engenharia.md).
FROM ollama/ollama:0.40.11
ARG SLM_MODEL=qwen3:4b-instruct
ENV OLLAMA_HOST=0.0.0.0:11434 OLLAMA_KEEP_ALIVE=30m OLLAMA_CONTEXT_LENGTH=8192
# Rede instável derruba o pull ("max retries exceeded") e o passo inteiro do build seria perdido: tenta de novo até
# 10 vezes; no mesmo passo, o Ollama continua do ponto em que parou.
RUN ollama serve > /tmp/ollama.log 2>&1 & pid=$!; \
    for i in $(seq 1 60); do ollama list > /dev/null 2>&1 && break; sleep 1; done; \
    pull() { for i in $(seq 1 10); do ollama pull "$1" && return 0; echo "pull de $1 falhou ($i), tentando de novo"; sleep 10; done; return 1; }; \
    pull "$SLM_MODEL" && kill $pid
EXPOSE 11434
