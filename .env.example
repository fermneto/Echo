# Copie para .env. Toda variável nova é validada em packages/config.

# Geral
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://echo:echo@localhost:5433/echo
# true no evento: login por persona, simulador e controles de ensaio
DEMO_MODE=true

# Portas locais (na Render, PORT é definida pela plataforma)
API_PORT=3001
WEB_PORT=3000

# Worker: endereço do painel (botão "Editar no painel" da nota do dia) e agenda do fim do expediente, em ms
WEB_URL=http://localhost:3000
END_OF_DAY_SCAN_MS=300000
# Hora UTC do lote da revisão noturna (5 = 02h em Fortaleza, 07h em Joanesburgo)
NIGHT_REVIEW_UTC_HOUR=5
# Modelo aberto (Ollama) da triagem da revisão noturna, do resumo do dia (worker) e do juiz da delegação da correção (worker). Local: `pnpm triage:up` e http://localhost:11435. Vazio = só a regra.
SLM_OLLAMA_URL=
SLM_MODEL=qwen3:4b-instruct
TRIAGE_TIMEOUT_MS=120000
# Roteador de custo da resposta: consulta de um fato ao gêmeo sai por regra, sem o Sonnet. false manda tudo ao modelo.
ANSWER_ROUTER=true
# SSLM para a dúvida da regra (no Ollama de SLM_OLLAMA_URL). Vazio = o mesmo modelo de SLM_MODEL; off = desligado.
SSLM_MODEL=
SSLM_TIMEOUT_MS=8000
SUMMARY_TIMEOUT_MS=300000

# Anthropic (chave da organização, nunca o login do claude.ai)
ANTHROPIC_API_KEY=

# Correção no Managed Agents (etapa 10), no worker. IDs vêm de `pnpm --filter @echo/reviewer provision`.
# Sem eles, não há correção (a revisão noturna continua).
FIX_AGENT_ID=
FIX_ENVIRONMENT_ID=
# Busca por revisões a corrigir e rascunhos prontos, e tempo máximo de uma correção, em ms
FIX_SCAN_MS=300000
FIX_TIMEOUT_MS=1200000

# Vídeo da semana da equipe (etapa 27), no worker. IDs vêm de `pnpm --filter @echo/reviewer provision-video`.
# Sem eles, não há vídeo (os relatórios seguem iguais). Teste na hora: `pnpm video:agora`.
VIDEO_AGENT_ID=
VIDEO_ENVIRONMENT_ID=
# Busca por equipes com a semana pronta e vídeos na fila, e tempo máximo de uma gravação, em ms
VIDEO_SCAN_MS=300000
VIDEO_TIMEOUT_MS=1200000

# Langfuse (opcional, SDK v6)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Slack: token do bot (xoxb-…). Worker e painel (lista da workspace para ligar a conta da pessoa no cadastro).
# Confira com: pnpm --filter @echo/connectors slack:check
SLACK_BOT_TOKEN=

# GitHub App (etapa 3), usado pelo worker e pelo painel (Meu plano confere o rascunho da correção). Confira com: pnpm --filter @echo/connectors github:check <instalação>
GITHUB_APP_ID=
# Chave privada do app em uma linha, com \n no lugar das quebras.
GITHUB_PRIVATE_KEY=

# App OAuth do Linear, instalado como app. Confira com: pnpm --filter @echo/connectors linear:check
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# Ou, para testar sem app OAuth, uma chave pessoal (Linear → Settings → Security & access → API keys):
LINEAR_API_KEY=

# Jira Cloud (etapa 21), no lugar do Linear: site, e-mail e token de API de uma conta de serviço
# (id.atlassian.com → Segurança → Tokens de API). Com o Linear ligado, o Linear vale. Guia: docs/integracoes/jira.md
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Campo dos story points neste site (padrão: customfield_10016) e filtro dos projetos importados.
JIRA_STORY_POINTS_FIELD=
JIRA_JQL=

# Reconciliação com GitHub e Linear (padrão: 10 min) e repositório do espelho das notas.
RECONCILE_INTERVAL_MS=600000
BRAINS_REPOSITORY=

# Endereço público da API (túnel ou Render): usado pelo diagnóstico e pelas ferramentas de teste.
API_PUBLIC_URL=

# Login no painel com o Slack (Basic Information do app). O retorno é PANEL_URL/api/sessao/slack/retorno.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
PANEL_URL=http://localhost:3000
# Assina o cookie de sessão do painel (openssl rand -hex 32).
SESSION_SECRET=

# Agenda (etapa 18). Google: conta de serviço com delegação no domínio (escopo calendar.events.readonly).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Chave privada da conta de serviço em uma linha, com \n no lugar das quebras.
GOOGLE_SERVICE_ACCOUNT_KEY=
# Microsoft 365: app multi-tenant com Calendars.ReadBasic e MailboxSettings.Read (permissões de aplicativo).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Deploys da Vercel (etapa 19): segredo do webhook.
VERCEL_WEBHOOK_SECRET=

# Webhooks (etapa 3). Sem o segredo, a rota responde 503.
GITHUB_WEBHOOK_SECRET=
SLACK_SIGNING_SECRET=
LINEAR_WEBHOOK_SECRET=
JIRA_WEBHOOK_SECRET=
# openssl rand -hex 32 — igual em web, api e worker. Trocar invalida as credenciais guardadas.
ENCRYPTION_KEY=

# Teste real das integrações (docs/teste-integracoes.md)
DEMO_ORG_NAME=Empresa de teste (integrações)
DEMO_SLACK_TEAM_ID=
DEMO_GITHUB_INSTALLATION_ID=
DEMO_LINEAR_ORG_ID=
# Site do Jira, como no endereço (ex.: acme.atlassian.net).
DEMO_JIRA_SITE=
# Agenda: domínio do Google Workspace e/ou tenant do Microsoft 365. Vercel: id do time.
DEMO_GOOGLE_DOMAIN=
DEMO_MICROSOFT_TENANT_ID=
DEMO_VERCEL_TEAM_ID=
# Pessoas do teste e as contas de cada uma (só dados de teste):
# [{"nome":"Marina","papel":"leader","slack":"U01","linear":"uuid"},{"nome":"Bruno","slack":"U02","github":"bruno-dev","linear":"uuid","rh":"123"}]
DEMO_IDENTITIES=

# Ensaiar a demonstração de dia: o dono da pergunta é tratado como ausente (só para a demo).
DEMO_ALWAYS_AWAY=false
