# Copie para .env. Toda variável nova é validada em packages/config.

# Geral
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://echo:echo@localhost:5433/echo
# true no evento: login por persona, simulador e controles de ensaio
DEMO_MODE=true

# Portas locais (na Render, PORT é definida pela plataforma)
API_PORT=3001
WEB_PORT=3000

# Anthropic (chave da organização, nunca o login do claude.ai)
ANTHROPIC_API_KEY=

# Langfuse (opcional, SDK v6)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Slack: token do bot (xoxb-…). Confira com: pnpm --filter @echo/connectors slack:check
SLACK_BOT_TOKEN=

# GitHub App (etapa 3). Confira com: pnpm --filter @echo/connectors github:check <instalação>
GITHUB_APP_ID=
# Chave privada do app em uma linha, com \n no lugar das quebras.
GITHUB_PRIVATE_KEY=

# App OAuth do Linear, instalado como app. Confira com: pnpm --filter @echo/connectors linear:check
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# Ou, para testar sem app OAuth, uma chave pessoal (Linear → Settings → Security & access → API keys):
LINEAR_API_KEY=

# Reconciliação com GitHub e Linear (padrão: 10 min) e repositório do espelho das notas.
RECONCILE_INTERVAL_MS=600000
BRAINS_REPOSITORY=

# Endereço público da API (túnel ou Render): usado pelo diagnóstico e pelas ferramentas de teste.
API_PUBLIC_URL=

# Login no painel com o Slack (Basic Information do app). O retorno é PANEL_URL/api/sessao/slack/retorno.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
PANEL_URL=http://localhost:3000
# Assina o cookie de sessão do painel (openssl rand -hex 32).
SESSION_SECRET=

# Agenda (etapa 18). Google: conta de serviço com delegação no domínio (escopo calendar.events.readonly).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Chave privada da conta de serviço em uma linha, com \n no lugar das quebras.
GOOGLE_SERVICE_ACCOUNT_KEY=
# Microsoft 365: app multi-tenant com Calendars.ReadBasic e MailboxSettings.Read (permissões de aplicativo).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Deploys da Vercel (etapa 19): segredo do webhook.
VERCEL_WEBHOOK_SECRET=

# Webhooks (etapa 3). Sem o segredo, a rota responde 503.
GITHUB_WEBHOOK_SECRET=
SLACK_SIGNING_SECRET=
LINEAR_WEBHOOK_SECRET=
# openssl rand -hex 32 — igual em web, api e worker. Trocar invalida as credenciais guardadas.
ENCRYPTION_KEY=

# Teste real das integrações (docs/teste-integracoes.md)
DEMO_ORG_NAME=Empresa de teste (integrações)
DEMO_SLACK_TEAM_ID=
DEMO_GITHUB_INSTALLATION_ID=
DEMO_LINEAR_ORG_ID=
# Agenda: domínio do Google Workspace e/ou tenant do Microsoft 365. Vercel: id do time.
DEMO_GOOGLE_DOMAIN=
DEMO_MICROSOFT_TENANT_ID=
DEMO_VERCEL_TEAM_ID=
# Pessoas do teste e as contas de cada uma (só dados de teste):
# [{"nome":"Marina","papel":"leader","slack":"U01","linear":"uuid"},{"nome":"Bruno","slack":"U02","github":"bruno-dev","linear":"uuid","rh":"123"}]
DEMO_IDENTITIES=
